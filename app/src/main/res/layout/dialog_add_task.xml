<?xml version="1.0" encoding="utf-8"?>
<!-- CardView used as a dialog container -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="24dp"
  >
    <!-- Main container inside card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Close button (top-right corner) -->
            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="@null"
                android:tint="#E53935"
                android:layout_gravity="end"
                android:contentDescription="Close"/>

            <!-- Dialog title -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type Your Task Here"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#893AFC"
                android:layout_marginTop="-12dp"/>

        </LinearLayout>

        <!-- Task Input Field -->
        <EditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="type your task here"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="12dp"/>

        <!-- Date & Time Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Date picker field -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Apr 1, 2025"
                android:textSize="13sp"
                android:textColor="#555555"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"/>

            <!-- Time picker field -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="9:41 AM"
                android:textSize="13sp"
                android:textColor="#555555"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTask"
                android:layout_width="0dp"
                android:layout_height="57dp"
                android:layout_weight="1"
                android:text="Save"
                android:textColor="#FFFFFF"
                app:backgroundTint="#8A3AFF"
                app:cornerRadius="24dp"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null"/>

            <!-- Cancel button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="57dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#8A3AFF"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#8A3AFF"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:layout_marginStart="8dp"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>