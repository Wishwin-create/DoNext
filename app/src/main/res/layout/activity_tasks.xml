<?xml version="1.0" encoding="utf-8"?>
<!-- Main layout using RelativeLayout -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Tasks Title -->

    <TextView
        android:id="@+id/tvTasksTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:text="@string/tasks"
        android:textColor="@color/purple_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Task List -->
    <ListView
        android:id="@+id/lvTasks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAddTodo"
        android:layout_below="@id/tvTasksTitle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="59dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:divider="@null"
        android:dividerHeight="8dp" />

    <!-- Add To Do Button -->

    <Button
        android:id="@+id/btnAddTodo"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_button_purple"
        android:stateListAnimator="@null"
        android:text="@string/add_todo"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Bottom Navigation Bar -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_nav_bar"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Tasks Navigation -->
        <LinearLayout
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Selected background container -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_selected">

                <!-- Tasks icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tasks"
                    android:contentDescription="Tasks" />
            </FrameLayout>

            <!-- Tasks text label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_tasks"
                android:textColor="@color/purple_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Profile Navigation -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Icon container -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp">
                <!-- Profile icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="Profile" />
            </FrameLayout>

            <!-- Profile text label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- About Navigation -->
        <LinearLayout
            android:id="@+id/navAbout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">


            <!-- Icon container -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp">
                <!-- About icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_about"
                    android:contentDescription="About" />
            </FrameLayout>

            <!-- About text label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_about"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
