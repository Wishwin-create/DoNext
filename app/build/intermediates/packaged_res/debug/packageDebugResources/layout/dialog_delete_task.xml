<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Close button (top right) -->
            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="@null"
                android:tint="#E53935"
                android:layout_gravity="end"
                android:contentDescription="Close"
                app:tint="#E53935" />

            <!-- Title below -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you sure you want to delete this task?"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#893AFC"
                android:layout_marginTop="-12dp"/>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmDelete"
                android:layout_width="0dp"
                android:layout_height="57dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textColor="#FFFFFF"
                app:backgroundTint="#8A3AFF"
                app:cornerRadius="24dp"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDelete"
                android:layout_width="0dp"
                android:layout_height="57dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#8A3AFF"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#8A3AFF"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:layout_marginStart="8dp"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>