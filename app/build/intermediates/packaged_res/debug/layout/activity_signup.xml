<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Logo -->
        <LinearLayout
            android:id="@+id/logoSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="DoNext Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DoNext"
                android:textColor="@color/purple_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Create Account Text -->
        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/logoSection"
            android:layout_marginTop="24dp"
            android:text="@string/create_account"
            android:textColor="@color/purple_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Full Name -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/tvCreateAccount"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/full_name"
            android:textColorHint="@color/text_dark"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/etFullName"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/username"
            android:textColorHint="@color/text_dark"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/etUsername"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/email"
            android:textColorHint="@color/text_dark"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/etEmail"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/password"
            android:textColorHint="@color/text_dark"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Confirm Password -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/etPassword"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/confirm_password"
            android:textColorHint="@color/text_dark"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Sign Up Button -->
        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/etConfirmPassword"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_purple"
            android:text="@string/sign_up"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:stateListAnimator="@null" />

        <!-- Sign In Link -->
        <TextView
            android:id="@+id/tvSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnSignUp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/have_account"
            android:textSize="14sp"
            android:textColor="@color/purple_primary"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>
</ScrollView>
